+// Q8_1 ds: FP16 scale d in the low half, exact int16 sum of the quantized int8 values in the high half
+// (the dequantized block sum is reconstructed in FP32 as d*sum_q, so it cannot overflow FP16).
+static __device__ __forceinline__ half2 make_q8_1_ds(const float d, const int sum_q) {
+    union {
+        half2    h;
+        uint32_t u;
+    } ds;
+    ds.h = make_half2(d, 0.0f);
+    ds.u = (ds.u & 0x0000FFFFu) | ((uint32_t) (uint16_t) (int16_t) sum_q << 16);
+    return ds.h;
+}
